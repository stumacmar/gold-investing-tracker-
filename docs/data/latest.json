 "glossary": {
  "score": {
   "term": "The score",
   "what": "All 14 signals squashed into one number from 0 to 100. Higher means more of the things that usually push gold up are happening right now.",
   "why": "It's a summary, not a prediction. 30 doesn't mean gold will fall \u2014 it means the usual reasons to buy aren't there."
  },
  "real_yields": {
   "term": "Real yield",
   "what": "The interest a safe US government bond pays you after you take inflation off. If a bond pays 4% and prices rise 2%, your real yield is 2%.",
   "why": "Gold pays you nothing at all. When bonds pay a good real return, people would rather own bonds. When real yields fall, gold gets more attractive. This is the single biggest driver."
  },
  "dollar": {
   "term": "The dollar index",
   "what": "A measure of how strong the US dollar is compared with a basket of other currencies.",
   "why": "Gold is priced in dollars. A stronger dollar usually means a lower gold price, because it takes fewer dollars to buy the same ounce."
  },
  "policy": {
   "term": "2-year yield & Fed funds",
   "what": "The 2-year yield shows what traders think US interest rates will average over the next couple of years. The Fed funds rate is what the US central bank charges today.",
   "why": "If the 2-year sits below Fed funds, the market is betting on rate cuts \u2014 which is good for gold. Above it means no cuts expected."
  },
  "breakevens": {
   "term": "Inflation expectations",
   "what": "What the bond market thinks inflation will average in future. Worked out by comparing normal bonds with inflation-protected ones.",
   "why": "Gold is bought as protection against money losing value. Rising inflation expectations usually help it."
  },
  "trend": {
   "term": "Moving averages",
   "what": "The average closing price over the last 50 days, or the last 200 days. It smooths out the daily noise so you can see the direction.",
   "why": "Price above both averages means an uptrend. A 'golden cross' is when the 50-day rises above the 200-day (good sign); a 'death cross' is the opposite."
  },
  "cot": {
   "term": "Positioning (COT)",
   "what": "A weekly US government report showing how much big speculative funds are betting on gold going up.",
   "why": "If almost everyone is already betting gold rises, there's nobody left to buy \u2014 and any bad news makes them all sell at once. Very low bets mean lots of buying power in reserve."
  },
  "valuation": {
   "term": "Stretch & RSI",
   "what": "How far price has run above its 200-day average, plus RSI \u2014 a 0-to-100 speedometer of how fast it has moved recently.",
   "why": "Above 70 on RSI means gold has risen very quickly and may need a rest. Below 30 means it has fallen very quickly and may bounce."
  },
  "fear": {
   "term": "VIX & credit spreads",
   "what": "VIX is the stock market's 'fear gauge' \u2014 how much turbulence investors expect. Credit spreads are the extra interest riskier companies must pay compared with the government.",
   "why": "When both rise, investors are scared and look for somewhere safe. Gold is the classic hiding place."
  },
  "gpr": {
   "term": "Geopolitical risk",
   "what": "An index that counts how often the world's newspapers mention war, terrorism and international conflict.",
   "why": "A scarier world usually puts a floor under the gold price."
  },
  "central_banks": {
   "term": "Central bank demand",
   "what": "How much gold the world's central banks \u2014 the institutions that run each country's money \u2014 are buying.",
   "why": "They have been the biggest buyers in recent years. Unlike traders, they buy for decades and rarely sell."
  },
  "etf": {
   "term": "ETF flows",
   "what": "Money moving in or out of funds that hold gold on investors' behalf, so people can own gold without storing it.",
   "why": "Shows whether ordinary Western investors are joining in or heading for the exit."
  },
  "gsr": {
   "term": "Gold/silver ratio",
   "what": "How many ounces of silver you could buy with one ounce of gold.",
   "why": "Silver is the more excitable metal. When it keeps up with gold, the rally is broad and healthy. When gold rises alone, the move can be running out of steam."
  },
  "labour": {
   "term": "Jobs data",
   "what": "Nonfarm payrolls is the monthly count of how many jobs the US added or lost. Jobless claims count how many people asked for unemployment help last week.",
   "why": "A weakening job market is what usually forces the central bank to cut interest rates \u2014 and rate cuts are gold's best friend."
  },
  "fx_stress": {
   "term": "FX stress & intervention",
   "what": "When a country's currency falls too far, its government can step in and buy it back to prop it up. That's an intervention.",
   "why": "Japan doing this means selling US government bonds to raise the money, which strains the whole financial system \u2014 and money moves toward gold."
  },
  "fair_value": {
   "term": "Fair value gap",
   "what": "Our estimate of what gold 'should' cost based only on interest rates and the dollar, compared with what it actually costs.",
   "why": "A big gap means something else is driving the price. Right now the estimate fails its own reliability check, so we show it but don't use it."
  },
  "regime": {
   "term": "Regime",
   "what": "What kind of market we're in right now \u2014 calm, panicking, inflation-driven, and so on.",
   "why": "The same signal matters more in some conditions than others, so the engine changes how much weight it gives each one depending on the regime."
  },
  "confidence": {
   "term": "Data confidence",
   "what": "Whether today's numbers all arrived fresh and on time, and whether the signals agree with each other.",
   "why": "Important: this is about the quality of the DATA, not whether the model is right. A high score built on stale data would be flagged here."
  },
  "atr": {
   "term": "ATR (daily range)",
   "what": "How many dollars gold moves in a typical day.",
   "why": "It doesn't tell you to buy or sell. It tells you how big a position should be \u2014 in a jumpy market the same position risks a lot more money."
  },
  "support": {
   "term": "Support",
   "what": "A price where gold has stopped falling before, more than once. Buyers showed up there.",
   "why": "It's a rough guide to where the next floor might be, not a guarantee."
  },
  "resistance": {
   "term": "Resistance",
   "what": "A price where gold has stopped rising before, more than once. Sellers showed up there.",
   "why": "It's a rough guide to where the next ceiling might be, not a guarantee."
  },
  "range": {
   "term": "Consolidation range",
   "what": "The price zone where gold has spent most of its time over the past year.",
   "why": "Think of it as the room gold keeps coming back to. Being above or below it tells you whether something has changed."
  },
  "backfill": {
   "term": "Backfilled (dashed line)",
   "what": "Scores worked out afterwards by replaying old data through today's model.",
   "why": "These are NOT calls the engine made at the time \u2014 nobody was watching. They're a rough check of whether the model would have been sensible."
  }
 },
